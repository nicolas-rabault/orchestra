{
  "description": "Guards that keep an opted-in project's main branch integrate-only, its merge gate for the merge gate alone, its drafts local, and its shared tasks claimed before they start; a roadmap format check that runs after every edit; and the one hook that speaks, handing an interactive conductor the answers waiting on the monitoring page. One process per tool call, never one per rule: a Bash call fires `guard-bash.mjs` alone, which runs its four rules cheapest-first.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-main-edit.mjs\"",
            "statusMessage": "Checking the main-is-integrate-only guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.mjs\"",
            "statusMessage": "Checking the orchestra Bash guards"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-roadmap.mjs\"",
            "statusMessage": "Linting the roadmap format"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/orchestra-inbox.mjs\"",
            "statusMessage": "Checking the orchestra monitor inbox"
          }
        ]
      }
    ]
  }
}
