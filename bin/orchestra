#!/usr/bin/env node
// The plugin's one entry point. Everything a skill, a hook or a human runs comes through here.
import { loadConfigOrThrow } from '../lib/config.mjs';
import { COMMANDS, register } from '../lib/cli/registry.mjs';
import { doctor } from '../lib/cli/doctor.mjs';
import { roadmapCommand } from '../lib/cli/roadmap.mjs';
import { journalCommand, inboxCommand, beatCommand, watchAnswersCommand, watchWorkersCommand, lockCommand } from '../lib/cli/register.mjs';
import { readyCommand, tickGateCommand, tickOutcomeCommand, tickWakeCommand, yieldCheckCommand } from '../lib/cli/tick.mjs';
import { notifyCommand } from '../lib/cli/notify.mjs';
import { codexCommand } from '../lib/cli/codex.mjs';
import { driveCommand } from '../lib/cli/drive.mjs';
import { briefCommand } from '../lib/cli/brief.mjs';
import { costCommand } from '../lib/cli/cost.mjs';
import { retireCommand } from '../lib/cli/retire.mjs';
import { archiveCommand, archiveImagesCommand } from '../lib/cli/archive.mjs';
import { landCommand, awaitCommand, queueListCommand } from '../lib/cli/gate.mjs';
import { monitorCommand, instancesCommand } from '../lib/cli/monitor.mjs';
import { ticketsCommand } from '../lib/cli/tickets.mjs';
import { installHeartbeatCommand } from '../lib/cli/heartbeat.mjs';
import { initCommand } from '../lib/cli/init.mjs';
import { prCommand } from '../lib/cli/pr.mjs';

register('doctor', { machine: true, run: ({ cfg }) => doctor(cfg) });
// `machine: true`: it is the command that WRITES `.orchestra/config.json` in the first place, so
// it must answer in exactly the project that has none yet — spec §3.1's off switch names it as one
// of the three exceptions alongside `doctor` and `instances`.
register('init', { machine: true, run: initCommand });
register('roadmap', { run: roadmapCommand });
register('journal', { run: journalCommand });
register('inbox', { run: inboxCommand });
register('beat', { run: beatCommand });
register('watch-answers', { run: watchAnswersCommand });
register('watch-workers', { run: watchWorkersCommand });
register('lock', { run: lockCommand });
register('ready', { run: readyCommand });
register('codex', { run: codexCommand });
register('notify', { run: notifyCommand });
register('drive', { run: driveCommand });
register('brief', { run: briefCommand });
register('cost', { run: costCommand });
register('retire', { run: retireCommand });
register('tick-gate', { run: tickGateCommand });
register('tick-outcome', { run: tickOutcomeCommand });
register('tick-wake', { run: tickWakeCommand });
register('yield-check', { run: yieldCheckCommand });
register('archive', { run: archiveCommand });
register('archive-images', { run: archiveImagesCommand });
register('land', { run: landCommand });
register('await', { run: awaitCommand });
register('queue-list', { run: queueListCommand });
register('tickets', { run: ticketsCommand });
register('pr', { run: prCommand });
// Not `machine: true`: this installs the timer FOR a project, so it needs that project's own
// config (its root, its id) exactly as `land` and `ready` do — it has no answer to give outside one.
register('install-heartbeat', { run: installHeartbeatCommand });
// `machine: true`: both answer about the MACHINE, not about a project — one page serves every
// project on it — so both must answer from a directory that has never heard of orchestra, spec
// §3.1's exception to the off switch.
register('monitor', { machine: true, run: monitorCommand });
register('instances', { machine: true, run: instancesCommand });

const [name, ...rest] = process.argv.slice(2);

if (!name || name === 'help' || name === '--help' || name === '-h') {
  process.stdout.write(`orchestra <subcommand>\n\n${[...COMMANDS.keys()].sort().map((k) => `  ${k}`).join('\n')}\n`);
  process.exit(0);
}

const cmd = COMMANDS.get(name);
if (!cmd) {
  process.stderr.write(`orchestra: unknown subcommand "${name}"\nknown: ${[...COMMANDS.keys()].sort().join(', ')}\n`);
  process.exit(2);
}

let cfg = null;
try {
  cfg = loadConfigOrThrow(process.cwd());
} catch (e) {
  process.stderr.write(`${e.message}\n`);
  process.exit(2);
}

// The off switch: outside the machine-level commands (see lib/cli/registry.mjs), no config means no
// behaviour at all.
if (!cfg && !cmd.machine) process.exit(0);

try {
  await cmd.run({ cfg, args: rest });
} catch (e) {
  process.stderr.write(`${e.message}\n`);
  process.exit(1);
}
